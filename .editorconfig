# EditorConfig - https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# Python
[*.py]
indent_size = 4
max_line_length = 100

# JavaScript/TypeScript
[*.{js,ts,json}]
indent_size = 2

# HTML/CSS
[*.{html,css,scss}]
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 4

# Markdown
[*.md]
trim_trailing_whitespace = false

# YAML
[*.{yml,yaml}]
indent_size = 2